{
  "name": "Totale KPI - Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1.0-3.11-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py --server.address 0.0.0.0"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
